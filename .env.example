# Penny Studio — environment
# Copy this file to `.env` and fill in the keys you need.
# (.env is git-ignored — your keys never get committed.)

# ============================================================
# GROQ_API_KEY — dùng cho PENNY RECUT (bắt buộc cho Recut)
# ============================================================
# Bóc transcript (Whisper) + AI thiết kế storyboard chạy qua Groq.
# Miễn phí, lấy tại: https://console.groq.com/keys
# ============================================================
GROQ_API_KEY=

# ============================================================
# KYMA_API_KEY — dùng cho PENNY DUB (bắt buộc cho Dub)
# ============================================================
# Dịch + lồng tiếng (eleven-v3) chạy qua một key Kyma duy nhất.
# Có credit miễn phí khi đăng ký: https://kymaapi.com
# (Nếu chỉ dùng Recut thì không cần key này.)
# ============================================================
KYMA_API_KEY=

# ============================================================
# ELEVENLABS_API_KEY — tuỳ chọn (voice-clone / TTS trực tiếp cho Dub)
# ============================================================
# Cần nếu muốn nhân bản giọng (voice clone). Lấy tại elevenlabs.io
# ============================================================
# ELEVENLABS_API_KEY=

# ============================================================
# Tuỳ chọn khác
# ============================================================
# KYMA_DUB_BASE=https://api.kymaapi.com
# PORT_V2=7861
